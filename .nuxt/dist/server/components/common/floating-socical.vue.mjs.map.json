{"file":"floating-socical.vue.mjs","mappings":";;;;AAAA,SAAA,eAAA,MAAA,OAAA,SACc;;;;;;;;;;","names":[],"sources":["../../../../../components/common/floating-socical.vue"],"sourcesContent":["<template>\n    <div class=\"floating-social\">\n        <div class=\"floating-social__item\">\n            <a href=\"https://www.facebook.com/papaviet.vn\" target=\"_blank\">\n                <i class=\"icon-facebook\"></i>\n            </a>\n        </div>\n        <div class=\"floating-social__item\">\n            <a href=\"https://www.instagram.com/papaviet.vn\" target=\"_blank\">\n                <i class=\"icon-instagram\"></i>\n            </a>\n        </div>\n        <div class=\"floating-social__item\">\n            <a href=\"https://www.youtube.com/channel/UC9J9Z9Z9J9Z9J9Z9J9Z9J9Z9\" target=\"_blank\">\n                <i class=\"icon-tiktok\"></i>\n            </a>\n        </div>\n    </div>\n</template>\n<style lang=\"scss\" scoped>\n.floating-social {\n    position: fixed;\n    top: 30%;\n    right: 0;\n    display: flex;\n    flex-direction: column;\n    gap: 24px;\n    z-index: 999;\n    background: linear-gradient(180deg, #801619 0%, #570F11 100%);\n    font-size: 24px;\n    color: #E4D3B0;\n    border-top-left-radius: 12px;\n    border-bottom-left-radius: 12px;\n    padding: 20px 12px;\n\n    &__item {\n        position: relative;\n        display: flex;\n        justify-content: center;\n        align-items: center;\n        cursor: pointer;\n        transition: all 0.3s;\n\n        img {\n            width: 20px;\n            height: 20px;\n        }\n\n        &:not(:last-child) {\n            &::before {\n                content: \"\";\n                position: absolute;\n                bottom: -12px;\n                left: 0;\n                width: 100%;\n                height: 1px;\n                background: #A82326;\n            }\n        }\n    }\n}\n</style>"],"version":3}