umns: 430px 1fr;\n    gap: 75px;\n\n    &__right {\n        padding-top: 24px;\n    }\n\n    @media (max-width: 1199px) {\n        grid-template-columns: 1fr;\n        gap: 14px;\n        .beef__buttons {\n            display: flex;\n            justify-content: center;\n            gap: 12px;\n        }\n    }\n}\n\n.box {\n    position: relative;\n    display: flex;\n    align-items: center;\n    gap: 36px;\n    padding: 32px;\n    border: 1px solid #525252;\n    background: #29292980;\n    border-radius: 24px;\n    overflow: hidden;\n\n    .item {\n        text-align: center;\n\n        &__thumb {\n            width: 64px;\n            height: 64px;\n            object-fit: contain;\n        }\n    }\n\n    &__link {\n        position: absolute;\n        top: 0;\n        right: 0;\n        width: 40px;\n        height: 40px;\n        object-fit: contain;\n        &:hover {\n            filter: brightness(1.05);\n        }\n    }\n}\n</style>"],"version":3}